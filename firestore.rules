rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 🛡️ SEGURANÇA ELITE: Regra Global de Leitura
    // Qualquer um pode ler produtos e configurações públicas
    match /produtos/{product} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
    
    // 📦 Pedidos: Cliente cria, Admin gerencia
    match /pedidos/{order} {
      allow read: if request.auth != null && (resource.data.customerEmail == request.auth.token.email || request.auth.token.admin == true);
      allow create: if true; // Permitimos criação anônima para checkout rápido
      allow update, delete: if request.auth != null && request.auth.token.admin == true;
    }

    // 🔒 Coleções Administrativas: Bloqueio Total
    match /{document=**} {
      allow read, write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
